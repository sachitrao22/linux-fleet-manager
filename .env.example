# `python launch.py` creates .env for you. Use this file only for Docker / manual setups.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-64-hex-chars
AGENT_TOKEN=replace-with-a-random-string

# agentless | agent | hybrid
FLEET_MODE=hybrid

# Default is a local SQLite file. Production:
# DATABASE_URL=postgresql+asyncpg://fleet:fleet@localhost:5432/fleetmanager
DATABASE_URL=sqlite+aiosqlite:///./fleet.db

# Agentless options
# SSH_KEY_PATH=/Users/you/.ssh/id_ed25519     # blank = ssh-agent / default keys
# SSH_STRICT_HOST_KEYS=true                   # recommended in production
# HOSTS_FILE=hosts.yaml
SSH_POLL_INTERVAL=30

# Alert thresholds (%)
CPU_WARN=80
CPU_CRIT=95
MEM_WARN=85
MEM_CRIT=95
DISK_WARN=85
DISK_CRIT=95
